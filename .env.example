GRPC_PORT=50051
SESSION_TTL=24h
SESSION_IDLE_TIMEOUT=30m
POSTGRES_HOST=postgres-usuarios
POSTGRES_PORT=5432
POSTGRES_DB=billetera_usuarios
POSTGRES_USER=app_usuarios
POSTGRES_PASSWORD=ejemplo-usuarios-cambiar
POSTGRES_SSLMODE=disable
KAFKA_BROKERS=kafka:9092
GRPC_TLS_CERT_FILE=.local-certs/server.crt
GRPC_TLS_KEY_FILE=.local-certs/server.key
GRPC_TLS_CA_FILE=.local-certs/ca.crt
GRPC_HEALTH_CERT_FILE=.local-certs/health.crt
GRPC_HEALTH_KEY_FILE=.local-certs/health.key
